{
  "name": "carrier-tms-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI planning agent runtime for Carrier TMS (model loop, prompts, provider adapters). No database access.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./dist/server.js",
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn ./src/server.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "cross-env": "7.0.3",
    "dotenv": "16.4.6",
    "express": "4.21.1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.10.1",
    "prettier": "3.6.2",
    "rimraf": "6.0.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.7.2"
  }
}
